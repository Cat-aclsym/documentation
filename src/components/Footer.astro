---
import Footer from 'lucode-starlight/components/overrides/Footer.astro';

const {template} = Astro.locals.starlightRoute.entry.data;
---

<Footer {...Astro.props}><slot /></Footer>
{template === 'doc' && <p class="copyright">Copyright © {new Date().getFullYear()} A7 Studio, Inc.</p>}

<style>
	.copyright {
		margin-top: 1.5rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--muted-foreground);
	}
</style>
